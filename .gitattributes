# Text normalisation so Windows and Unix contributors agree on what changed.
# This repository contains no large binaries, so no Git LFS filters are needed.

*.md      text eol=lf
*.ps1     text eol=crlf
*.bat     text eol=crlf
*.yml     text eol=lf
*.yaml    text eol=lf
*.toml    text eol=lf
*.json    text eol=lf
*.example text eol=lf
