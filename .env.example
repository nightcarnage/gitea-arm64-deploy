# Copy this file to `.env` and adjust. Docker Compose reads `.env` automatically.
#
#   Copy-Item .env.example .env
#
# .env is ignored by git on purpose - it is where machine-specific values live.

# Port for the Gitea web UI and HTTP clones.
HTTP_PORT=3000

# Port for SSH clones (ssh://git@localhost:3022/owner/repo.git).
#
# Do NOT change this to 2222 without checking first. Windows reserves ranges of
# TCP ports for Hyper-V/WSL, and 2222 commonly lands inside one, which produces
# a confusing "access permissions" bind error. Verify with:
#
#   netsh interface ipv4 show excludedportrange protocol=tcp
SSH_PORT=3022

# Timezone for commit timestamps in the web UI.
TZ=UTC

# ---------------------------------------------------------------------------
# Used by scripts\Deploy-Gitea.ps1 only. Safe to leave as defaults for a local
# instance; change them if this server is ever reachable by anyone else.
# ---------------------------------------------------------------------------
GITEA_ADMIN_USER=gitadmin
GITEA_ADMIN_PASSWORD=changeme123
GITEA_ADMIN_EMAIL=admin@localhost.local
